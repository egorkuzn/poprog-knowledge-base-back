# Production env template for poprog-portal-backend.
# Copy this file to /home/<deploy-user>/poprog-portal-backend/.env on the server
# and replace placeholder values. Do not commit real secrets.

# Docker image tag is normally provided by GitHub Actions during deploy.
# Keep this value only for manual docker compose runs.
BACKEND_IMAGE=ghcr.io/egorkuzn/poprog-knowledge-base-back:latest

# PostgreSQL credentials used by deploy/compose/docker-compose.prod.yml.
# The database itself is expected to be reachable as postgres:5432
# inside the auth-ride_default Docker network.
POPROG_DB_USER=<poprog_db_user>
POPROG_DB_PASSWORD=<poprog_db_password>

# Optional backend overrides. docker-compose.prod.yml already sets these
# explicitly, but keeping them here documents the production contract.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://postgres:5432/poprog_kb
SEARCH_ENABLED=true
SEARCH_REPOSITORIES_ENABLED=false
SEARCH_HEALTH_ENABLED=false
ELASTICSEARCH_URIS=http://elasticsearch:9200
FILES_STORAGE_DIR=/app/storage
FILES_BASE_URL=/files

# GigaChat is disabled in the current production deployment until credentials,
# trust store and operational policy are finalized.
GIGACHAT_ENABLED=false
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TRUST_STORE_PATH=
GIGACHAT_TRUST_STORE_PASSWORD=
GIGACHAT_TRUST_STORE_TYPE=PKCS12

# Keycloak/OIDC auth for protected account and admin endpoints.
KEYCLOAK_AUTH_ENABLED=true
KEYCLOAK_BASE_URL=http://95.174.95.251
KEYCLOAK_ISSUER_URI=http://95.174.95.251/realms/reflex-ide
KEYCLOAK_JWK_SET_URI=http://95.174.95.251/realms/reflex-ide/protocol/openid-connect/certs
KEYCLOAK_REALM=reflex-ide
KEYCLOAK_CLIENT_ID=reflex-web-client
KEYCLOAK_REQUIRED_AUDIENCE=reflex-web-client
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=<keycloak_admin_username>
KEYCLOAK_ADMIN_PASSWORD=<keycloak_admin_password>

# Temporary dev-header mode for local/dev portal account testing.
# Keep disabled in production after the frontend starts sending Keycloak tokens.
AUTH_DEV_HEADERS_ENABLED=false
AUTH_DEV_HEADERS_SUBJECT_HEADER=subject
AUTH_DEV_HEADERS_EMAIL_HEADER=email
AUTH_DEV_HEADERS_NAME_HEADER=name
AUTH_DEV_HEADERS_ROLES_HEADER=roles
AUTH_DEV_HEADERS_ALLOWED_PROFILES=local,dev
